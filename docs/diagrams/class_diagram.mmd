        +evidenceCompleteness() String
        +verificationState() String
    }
    class ActivityRevision {
        +String revisionId
        +int revisionNo
        +DateTime performedAt
        +String timePrecision
        +String attributes
        +DateTime recordedAt
        +String reason
    }
    class ActivityInput {
        +Decimal quantity
        +String unit
    }
    class Device {
        +String deviceId
        +String sensorType
        +String unit
        +DateTime createdAt
    }
    class Observation {
        +String observationId
        +DateTime observedAt
        +Decimal value
        +DateTime recordedAt
        +String sourceChannel
        +String externalRef
    }
    class Lot {
        +String lotId
        +String publicCode
        +String lotType
        +DateTime createdAt
        +String sourceChannel
        +String externalRef
        +currentRevision() LotRevision
        +traceSources() List
        +traceDestinations() List
        +status() LotStatus
        +timeline() List
    }
    class LotRevision {
        +String lotRevisionId
        +int revisionNo
        +String productName
        +Decimal quantity
        +String unit
        +String packagingSpec
        +String attributes
        +DateTime recordedAt
        +String reason
        +verificationState() String
    }
    class LotEvent {
        +String eventId
        +String eventType
        +DateTime occurredAt
        +String timePrecision
        +DateTime recordedAt
        +String sourceChannel
        +String externalRef
        +evidenceCompleteness() String
        +verificationState() String
    }
    class LotInput {
        +Decimal quantityUsed
        +String unit
        +DateTime recordedAt
    }
    class Certification {
        +String certificationId
        +String standard
        +String certNumber
        +Date validFrom
        +Date validTo
        +DateTime createdAt
        +isValidOn(date) bool
    }
    class Evidence {
        +String evidenceId
        +String evidenceKind
        +String uri
        +String sha256
        +DateTime capturedAt
        +DateTime recordedAt
        +String sourceChannel
        +String externalRef
    }
    class EvidenceLink {
        +String linkId
        +DateTime linkedAt
    }
    class Verification {
        +String verificationId
        +String result
        +String method
        +String note
        +String supersedeReason
        +DateTime verifiedAt
        +DateTime recordedAt
        +isEffective() bool
    }
