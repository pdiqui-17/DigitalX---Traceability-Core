# Kết nối PostgreSQL để chạy kiểm thử (copy thành db/.env rồi điền).
# db/.env KHÔNG được commit (.gitignore đã chặn).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
# Database tạm cho kiểm thử: bị XÓA và TẠO LẠI mỗi lần chạy.
# Tên bắt buộc kết thúc bằng _test để tránh xóa nhầm database thật.
PGDATABASE=traceability_test
# Đường dẫn psql (để trống nếu psql đã có trong PATH)
PSQL=C:/Program Files/PostgreSQL/18/bin/psql.exe
